# ID da planilha mestra (aba Clientes: email do dono -> planilha da loja -> plano)
MASTER_SHEET_ID=

# Upstash Ratelimit (Fase 5)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
