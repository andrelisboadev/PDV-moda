# Copie para .env.local e preencha. NUNCA commite valores reais.

# Auth.js
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Conta de serviço do Google (JSON inteiro em base64). Só no servidor.
GOOGLE_SERVICE_ACCOUNT_B64=

# ID da planilha mestra (aba Clientes: email do dono -> planilha da loja -> plano)
MASTER_SHEET_ID=

# Limite de acessos (opcional; sem isso usa a memória do servidor)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Rotina diária (backup + conferência). Gere um texto longo e aleatório (32+ caracteres).
# A Vercel envia este valor sozinha quando chama /api/cron/diario.
CRON_SECRET=

# SÓ para testes automáticos na sua máquina (Playwright). NUNCA coloque na Vercel.
# E2E_LOGIN_SECRET=
